# ===========================================
# VoleyStats Frontend - Variables de Entorno
# ===========================================
# Copia este archivo como .env y configura los valores según tu entorno

# ===========================================
# CONFIGURACIÓN OBLIGATORIA
# ===========================================

# URL del backend API (OBLIGATORIO)
# Desarrollo: http://localhost:3001/api
# Producción: https://tu-backend-domain.com/api
VITE_API_URL=http://localhost:3001/api

# ===========================================
# CONFIGURACIÓN DE LA APLICACIÓN
# ===========================================

# Nombre de la aplicación
VITE_APP_NAME=VoleyStats

# Versión de la aplicación
VITE_APP_VERSION=1.0.0

# ===========================================
# CONFIGURACIÓN OPCIONAL
# ===========================================

# Habilitar notificaciones (true/false)
VITE_ENABLE_NOTIFICATIONS=true

# Dominio de autenticación
VITE_AUTH_DOMAIN=localhost

# ID de analytics (Google Analytics, etc.)
VITE_ANALYTICS_ID=

# ===========================================
# CONFIGURACIÓN DE DESARROLLO
# ===========================================

# Modo de desarrollo (true/false)
VITE_DEV_MODE=true

# Habilitar logs de debug
VITE_DEBUG_MODE=true

# ===========================================
# CONFIGURACIÓN DE PRODUCCIÓN
# ===========================================

# URL del frontend en producción
VITE_FRONTEND_URL=https://voleystats.com

# Configuración de CORS
VITE_CORS_ORIGIN=https://voleystats.com

# ===========================================
# CONFIGURACIÓN DE SERVICIOS EXTERNOS
# ===========================================

# Configuración de email (opcional)
VITE_EMAIL_SERVICE_URL=

# Configuración de storage (opcional)
VITE_STORAGE_URL=

# ===========================================
# NOTAS IMPORTANTES
# ===========================================
# 1. VITE_API_URL es OBLIGATORIO - sin esta variable la app no funcionará
# 2. Todas las variables deben empezar con VITE_ para ser accesibles en el frontend
# 3. No incluyas espacios alrededor del signo =
# 4. Para valores booleanos usa 'true' o 'false' como strings
# 5. Reinicia el servidor de desarrollo después de cambiar variables
